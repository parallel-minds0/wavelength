+/* Engine-neutral editable model assets publish only into the Models browser.
+ * Prop assignment in the viewport keeps its existing, separate drop path. */
+static bool model_asset_drop_poll(bContext *C, wmDrag *drag, const wmEvent * /*event*/)
+{
+  ID *id = WM_drag_get_local_ID(drag, ID_OB);
+  if (!id || !id->properties ||
+      !IDP_GetPropertyFromGroup(id->properties, "wl_model_asset"))
+  {
+    return false;
+  }
+  wmOperatorType *ot = WM_operatortype_find("WAVELENGTH_OT_publish_model_drop", true);
+  return ot && WM_operator_poll(C, ot);
