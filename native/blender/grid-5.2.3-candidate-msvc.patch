+  const wmOperatorStatus result = WM_operator_name_call(
+      C, backend->idname, wm::OpCallContext::ExecDefault, &props, nullptr);
+  WM_operator_properties_free(&props);
+  return (result & (OPERATOR_FINISHED | OPERATOR_RUNNING_MODAL)) ? OPERATOR_FINISHED :
+                                                                 OPERATOR_CANCELLED;
