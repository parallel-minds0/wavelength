+float wavelength_coverage(float2 p, float2 footprint, float interval)
+{
+  float2 distance_to_line = abs(mod(p + interval * 0.5f, interval) - interval * 0.5f);
+  float2 coverage = 1.0f - smoothstep(float2(0.25f), float2(1.25f), distance_to_line / footprint);
+  return max(coverage.x, coverage.y);
+}
+
+void wavelength_grid_fragment()
+{
+  float2 ndc = gl_FragCoord.xy / uniform_buf.size_viewport * 2.0f - 1.0f;
+  float4 near_h = drw_view().viewinv * (drw_view().wininv * float4(ndc, -1.0f, 1.0f));
+  float4 far_h = drw_view().viewinv * (drw_view().wininv * float4(ndc, 1.0f, 1.0f));
+  float3 near_p = near_h.xyz / near_h.w;
+  float3 far_p = far_h.xyz / far_h.w;
+  float3 ray = far_p - near_p;
+  int axis = flag_test(grid_flag, PLANE_XZ) ? 1 : (flag_test(grid_flag, PLANE_YZ) ? 0 : 2);
+  if (abs(ray[axis]) < 1e-8f) { gpu_discard_fragment(); return; }
+  float t = -near_p[axis] / ray[axis];
+  if (t < 0.0f || t > 1.0f) { gpu_discard_fragment(); return; }
+  float3 world = near_p + t * ray;
+  float2 p = axis == 2 ? world.xy : (axis == 1 ? world.xz : world.yz);
+  float2 footprint = max(gpu_fwidth(p), float2(1e-7f));
+  float pixel_world = max(footprint.x, footprint.y);
+  float parent = grid_buf.wavelength.y;
+  float minor = parent / grid_buf.wavelength.z;
+  float selected = wavelength_coverage(p, footprint, parent) * smoothstep(2.0f, 6.0f, parent / pixel_world);
+  float grey = wavelength_coverage(p, footprint, minor) * smoothstep(2.0f, 6.0f, minor / pixel_world);
+  float alpha = max(selected * 0.65f, grey * 0.28f);
+  float2 axes = axis == 2 ? float2(flag_test(grid_flag, AXIS_Y),flag_test(grid_flag, AXIS_X)) :
+                (axis == 1 ? float2(flag_test(grid_flag, AXIS_Z),flag_test(grid_flag, AXIS_X)) :
+                             float2(flag_test(grid_flag, AXIS_Z),flag_test(grid_flag, AXIS_Y)));
+  float2 axis_coverage = 1.0f - smoothstep(float2(0.25f),float2(1.25f),abs(p)/footprint);
+  alpha *= 1.0f - max(axis_coverage.x*axes.x,axis_coverage.y*axes.y);
+  if (alpha < 0.005f) { gpu_discard_fragment(); return; }
+  out_color = float4(mix(float3(0.43f),float3(1.0f,0.85f,0.10f),selected),alpha);
+  line_output = float4(0.0f);
+  float4 clip = drw_view().winmat * (drw_view().viewmat * float4(world,1.0f));
+  /* Match Blender's native aligned-view grid ordering. Perspective uses actual
+   * plane depth, never a Python POST_VIEW offset or a second depth buffer. */
+  gl_FragDepth = flag_test(grid_flag, GRID_BEHIND_GEOMETRY) ? 1.0f :
+                  clamp(0.5f * clip.z / clip.w + 0.5f,0.0f,1.0f);
+}
