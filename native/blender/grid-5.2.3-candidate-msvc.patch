+inline Texture read_vtf(const Bytes &bytes)
+{
+  Reader r{bytes};r.bounds(0,64);
+  if(std::memcmp(bytes.data(),"VTF\0",4) || r.i(4)!=7 || r.i(8)>5 || r.i(8)<0)throw std::runtime_error("Unsupported VTF version");
