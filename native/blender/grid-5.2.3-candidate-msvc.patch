+static wmOperatorStatus model_asset_publish_exec(bContext *C, wmOperator *op)
+{
+  wmOperatorType *backend = WM_operatortype_find("WAVELENGTH_OT_publish_model_drop", true);
+  if (!backend || !WM_operator_poll(C, backend)) {
+    return OPERATOR_CANCELLED;
+  }
+  char name[MAX_ID_NAME];
+  RNA_string_get(op->ptr, "source_name", name);
