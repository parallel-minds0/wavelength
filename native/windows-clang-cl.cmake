# Experimental Linux -> Windows MSVC-ABI toolchain. Not a validated Blender build.
set(CMAKE_SYSTEM_NAME Windows)
set(CMAKE_SYSTEM_PROCESSOR AMD64)
get_filename_component(_wl_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(WAVELENGTH_WINDOWS_SDK "${_wl_root}/build/toolchains/windows-sdk" CACHE PATH "xwin splat output")
find_program(CMAKE_C_COMPILER NAMES clang-cl REQUIRED)
find_program(CMAKE_CXX_COMPILER NAMES clang-cl REQUIRED)
find_program(CMAKE_LINKER NAMES lld-link REQUIRED)
find_program(CMAKE_AR NAMES llvm-lib REQUIRED)
find_program(CMAKE_RC_COMPILER NAMES llvm-rc REQUIRED)
set(CMAKE_C_COMPILER_TARGET x86_64-pc-windows-msvc)
set(CMAKE_CXX_COMPILER_TARGET x86_64-pc-windows-msvc)
set(_wl_includes "")
foreach(_wl_dir crt/include sdk/include/ucrt sdk/include/shared sdk/include/um sdk/include/winrt)
  if(NOT IS_DIRECTORY "${WAVELENGTH_WINDOWS_SDK}/${_wl_dir}")
    message(FATAL_ERROR "Missing xwin directory: ${WAVELENGTH_WINDOWS_SDK}/${_wl_dir}")
  endif()
  string(APPEND _wl_includes " /imsvc\"${WAVELENGTH_WINDOWS_SDK}/${_wl_dir}\"")
endforeach()
set(CMAKE_C_FLAGS_INIT "${_wl_includes}")
set(CMAKE_CXX_FLAGS_INIT "${_wl_includes}")
set(_wl_libs "")
foreach(_wl_dir crt/lib/x86_64 sdk/lib/ucrt/x86_64 sdk/lib/um/x86_64)
  string(APPEND _wl_libs " /libpath:\"${WAVELENGTH_WINDOWS_SDK}/${_wl_dir}\"")
endforeach()
set(CMAKE_EXE_LINKER_FLAGS_INIT "${_wl_libs}")
set(CMAKE_SHARED_LINKER_FLAGS_INIT "${_wl_libs}")
set(CMAKE_MODULE_LINKER_FLAGS_INIT "${_wl_libs}")
set(CMAKE_FIND_ROOT_PATH "${WAVELENGTH_WINDOWS_SDK}")
set(CMAKE_FIND_ROOT_PATH_MODE_PROGRAM NEVER)
set(CMAKE_FIND_ROOT_PATH_MODE_LIBRARY ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_INCLUDE ONLY)
set(CMAKE_FIND_ROOT_PATH_MODE_PACKAGE ONLY)
